#!/bin/bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for dir in "$script_dir"/*/; do
    include_dir="${dir}test_case/include"
    src_dir="${dir}test_case/src"
    if [[ -d "$include_dir" && -d "$src_dir" ]]; then
        find "$include_dir" -maxdepth 1 -type f -name '*.h' -exec cp {} "$src_dir/" \;
    fi
done
